@inject CampusEventManager.Web.Services.AuthService Auth
@implements IDisposable

@code {
    [Parameter]
    public EventCallback OnRestored { get; set; }

    protected override void OnInitialized()
    {
        Auth.OnChange += HandleAuthChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var restored = await Auth.TryRestoreAsync();
        if (restored.HasValue)
            await OnRestored.InvokeAsync();
    }

    private void HandleAuthChange()
    {
        InvokeAsync(async () =>
        {
            await OnRestored.InvokeAsync();
        });
    }

    public void Dispose()
    {
        Auth.OnChange -= HandleAuthChange;
    }
}
