@page "/profile"
@rendermode InteractiveServer
@inject CampusEventManager.Web.Services.AuthService Auth
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>My Profile</PageTitle>

@if (!Auth.IsRestored)
{
    <p class="text-muted">Loading...</p>
}
else if (Auth.CurrentUser is null)
{
    NavigationManager.NavigateTo("/login", true);
}
else
{
    <div class="page-header">
        <h3>My Profile</h3>
    </div>

    <div class="profile-card">
        <div class="profile-field">
            <div class="profile-field-label">Display Name</div>
            <div class="profile-field-value">@Auth.CurrentUser.DisplayName</div>
        </div>
        <div class="profile-field">
            <div class="profile-field-label">Email</div>
            <div class="profile-field-value">@Auth.CurrentUser.Email</div>
        </div>
        <div class="profile-field">
            <div class="profile-field-label">Role</div>
            <div class="profile-field-value">@(Auth.CurrentUser.CanCreateEvents ? "Event Creator" : "Attendee")</div>
        </div>

        <hr style="margin:1.25rem 0" />

        <button class="btn btn-outline-danger" @onclick="Logout">Logout</button>
    </div>
}

@code {
    protected override void OnInitialized() => Auth.OnChange += OnAuthChanged;
    private void OnAuthChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.OnChange -= OnAuthChanged;

    private void Logout()
    {
        Auth.Logout();
        NavigationManager.NavigateTo("/login", true);
    }
}
