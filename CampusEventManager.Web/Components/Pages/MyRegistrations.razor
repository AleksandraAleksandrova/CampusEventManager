@page "/my-registrations"
@rendermode InteractiveServer
@inject CampusEventManager.Web.Services.AuthService Auth
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>My Registrations</PageTitle>

<div class="page-header">
    <h3>My Registrations</h3>
</div>

@if (isLoading)
{
    <p class="text-muted">Loading...</p>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (!regs.Any())
{
    <div class="alert alert-info">You have no registrations yet.</div>
}
else
{
    @foreach (var r in regs)
    {
        <div class="event-card">
            <div class="event-card-body">
                <div class="event-card-title">
                    <a href="/events/@r.EventId" style="color:inherit;text-decoration:none">
                        @(r.EventTitle ?? $"Event {r.EventId}")
                    </a>
                </div>
                <div class="event-card-meta">
                    Role: <strong>@r.Role</strong> · Registered @r.RegisteredAt.ToLocalTime().ToString("g")
                </div>
                @if (!string.IsNullOrEmpty(r.ErrorMessage))
                {
                    <div class="alert alert-danger mt-1" style="padding:.4rem .7rem;font-size:.8rem">@r.ErrorMessage</div>
                }
            </div>
            <div class="event-card-actions">
                <button class="btn btn-outline-danger btn-sm" disabled="@r.InFlight" @onclick="() => Cancel(r)">
                    @(r.InFlight ? "Cancelling…" : "Cancel")
                </button>
            </div>
        </div>
    }
}

@code {
    private bool isLoading = true;
    private string? error;
    private List<RegistrationItem> regs = new();
    private bool _loaded;

    protected override void OnInitialized() => Auth.OnChange += OnAuthChanged;
    private void OnAuthChanged() => InvokeAsync(TryLoad);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await TryLoad();
    }

    private async Task TryLoad()
    {
        if (!Auth.IsRestored) return;
        if (Auth.CurrentUser is null) { NavigationManager.NavigateTo("/login", true); return; }
        if (_loaded) return;
        _loaded = true;
        try
        {
            var client = Auth.CreateAuthorizedClient("registration");
            var list = await client.GetFromJsonAsync<List<RegistrationDto>>("/api/registrations/me");
            if (list != null)
            {
                regs = list.Select(r => new RegistrationItem
                {
                    Id = r.Id,
                    EventId = r.EventId,
                    Role = r.Role,
                    RegisteredAt = r.RegisteredAt
                }).ToList();
                foreach (var item in regs)
                    _ = LoadEventTitle(item);
            }
        }
        catch (Exception ex) { error = ex.Message; }
        finally { isLoading = false; await InvokeAsync(StateHasChanged); }
    }

    public void Dispose() => Auth.OnChange -= OnAuthChanged;

    private async Task LoadEventTitle(RegistrationItem item)
    {
        try
        {
            var client = Auth.CreateAuthorizedClient("apiservice");
            var ev = await client.GetFromJsonAsync<EventTitleDto>($"/api/events/{item.EventId}");
            item.EventTitle = ev?.Title ?? $"Event {item.EventId}";
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private async Task Cancel(RegistrationItem r)
    {
        r.InFlight = true;
        r.ErrorMessage = null;
        StateHasChanged();
        try
        {
            var client = Auth.CreateAuthorizedClient("registration");
            var resp = await client.DeleteAsync($"/api/registrations/{r.Id}");
            if (resp.IsSuccessStatusCode)
                regs.Remove(r);
            else if (resp.StatusCode == System.Net.HttpStatusCode.Forbidden)
                r.ErrorMessage = "You cannot cancel this registration.";
            else
                r.ErrorMessage = $"Failed to cancel ({(int)resp.StatusCode}).";
        }
        catch (Exception ex) { r.ErrorMessage = ex.Message; }
        finally { r.InFlight = false; StateHasChanged(); }
    }

    private class RegistrationItem
    {
        public int Id { get; set; }
        public int EventId { get; set; }
        public string Role { get; set; } = string.Empty;
        public DateTime RegisteredAt { get; set; }
        public bool InFlight { get; set; }
        public string? ErrorMessage { get; set; }
        public string? EventTitle { get; set; }
    }

    private class RegistrationDto
    {
        public int Id { get; set; }
        public int UserId { get; set; }
        public int EventId { get; set; }
        public string Role { get; set; } = string.Empty;
        public DateTime RegisteredAt { get; set; }
    }

    private class EventTitleDto { public string Title { get; set; } = null!; }
}
