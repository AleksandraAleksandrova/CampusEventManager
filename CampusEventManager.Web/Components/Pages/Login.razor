@page "/login"
@rendermode InteractiveServer
@layout CampusEventManager.Web.Components.Layout.PublicLayout
@inject CampusEventManager.Web.Services.AuthService Auth
@inject NavigationManager NavigationManager
@using System.ComponentModel.DataAnnotations

<PageTitle>Login</PageTitle>

<h3>Login</h3>

@if (message is not null)
{
    <div class="alert alert-danger">@message</div>
}

<EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="loginModel.Email" />
        <ValidationMessage For="@(() => loginModel.Email)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Password</label>
        <InputText class="form-control" type="password" @bind-Value="loginModel.Password" />
        <ValidationMessage For="@(() => loginModel.Password)" />
    </div>

    <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">
        @(_isSubmitting ? "Signing in..." : "Login")
    </button>
    <a class="btn btn-link" href="/register">Register instead</a>
</EditForm>

@code {
    private bool _isSubmitting;
    private LoginModel loginModel = new();
    private string? message;

    private async Task HandleLogin()
    {
        message = null;
        _isSubmitting = true;
        try
        {
            var ok = await Auth.LoginAsync(loginModel.Email, loginModel.Password);
            if (!ok)
            {
                message = "Login failed. Check your credentials.";
                return;
            }
            NavigationManager.NavigateTo("/events");
        }
        catch (Exception ex)
        {
            message = $"Login error: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class LoginModel
    {
        [Required]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
