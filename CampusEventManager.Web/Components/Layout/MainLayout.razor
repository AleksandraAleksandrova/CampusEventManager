@inherits LayoutComponentBase
@inject CampusEventManager.Web.Services.AuthService AuthServiceInstance

<div class="page">
    <div class="sidebar">
        <NavMenu />
        <AuthInitializer OnRestored="OnAuthRestored" />
    </div>

    <main>
        <div class="top-row">
            @if (AuthServiceInstance?.CurrentUser is not null)
            {
                <a href="/profile">My Profile</a>
            }
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private void OnAuthRestored() => StateHasChanged();
}
