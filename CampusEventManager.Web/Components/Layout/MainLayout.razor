@inherits LayoutComponentBase
@inject CampusEventManager.Web.Services.AuthService AuthServiceInstance
@inject NavigationManager NavigationManager

<div class="page">
    <div class="sidebar">
        <NavMenu />
        <AuthInitializer OnRestored="OnAuthRestored" />
    </div>

@code {
    private bool _hasRestoredAuth = false;

    // AuthInitializer will trigger restoration when interactive. We show a loading state until restored.
    private bool _showingLoading = true;

    protected override void OnAfterRender(bool firstRender)
    {
        // No-op here; AuthInitializer component will perform restoration and then the layout will re-render.
    }

    private void Logout()
    {
        AuthServiceInstance.Logout();
        NavigationManager.NavigateTo("/login", true);
    }
}

    <main>
        <div class="top-row px-4">
            <div class="d-flex justify-content-between w-100">
                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                <div>
                    @if (AuthServiceInstance?.CurrentUser is not null)
                    {
                        <span class="me-2">Hello, @AuthServiceInstance.CurrentUser.DisplayName</span>
                        <button class="btn btn-link" @onclick="Logout">Logout</button>
                    }
                    else
                    {
                        <NavLink href="/login">Sign in</NavLink>
                    }
                </div>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private void OnAuthRestored()
    {
        // Called after AuthInitializer completes interactive restoration
        StateHasChanged();
    }
}
